            ],
            "url": "{{base_url}}/admin/product-variants/1/stock",
            "description": "Set the new count with the count you saw. Count moved → 409 STOCK_CHANGED. `note` required for `other`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 12,\n  \"expected_stock\": 8,\n  \"reason_code\": \"restock\",\n  \"note\": \"\"\n}"
