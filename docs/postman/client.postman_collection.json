              },
              {
                "key": "Authorization",
                "value": "Bearer {{client_token}}"
              }
            ],
            "url": "{{base_url}}/client/conversations?filter[status]=&per_page=15",
            "description": "Newest activity first. `filter[status]` active | read_only (archive). Example item: {\"id\": 7, \"status\": \"active\", \"status_label\": \"Active\", \"can_send\": true, \"service_request\": {\"id\": 12, \"reference\": \"RN-1234567\", \"status\": \"offers_received\", \"status_label\": \"Offers received\", \"service\": {\"id\": 3, \"name\": \"Photography\"}, \"event_type\": {\"id\": 1, \"name\": \"Wedding\"}, \"event_date\": \"2026-12-05\", \"booking_id\": null}, \"provider\": {\"id\": 4, \"display_name\": \"Noura Lens\", \"avatar_url\": null, \"is_verified\": true}, \"last_message\": {\"id\": 31, \"type\": \"text\", \"body\": \"Is the date available?\", \"is_mine\": true, \"created_at\": \"2026-11-15T09:00:00Z\"}, \"last_message_at\": \"2026-11-15T09:00:00Z\", \"unread_count\": 0, \"created_at\": \"2026-11-15T08:59:00Z\"}"
