              },
              {
                "key": "Authorization",
                "value": "Bearer {{provider_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/provider/services/{{provider_service_id}}/event-location",
            "description": "D73. Turning it on needs `confirm: true` (her explicit confirmation; 422 `confirm` otherwise) and sets `event_location_confirmed_at`; `{\"at_event_location\": false}` turns it off and clears the confirmation. Only confirmed services count for open requests. Her own services only (404), active providers only (409 INVALID_STATE).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"at_event_location\": true,\n  \"confirm\": true\n}"
            }
          }
        },
