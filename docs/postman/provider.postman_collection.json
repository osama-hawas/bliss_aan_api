              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/provider/services",
            "description": "Her services with effective price, inclusions (enabled flags) and add-on prices. Active providers only (409 INVALID_STATE otherwise)."
          }
        },
        {
          "name": "Add service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{provider_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/provider/services",
            "description": "Adds a catalog service on the guide price. 201. Active providers only (409 INVALID_STATE otherwise). D74: at least one execution place (`at_event_location` with `confirm: true`, and/or `at_provider_location`); none → 422 `execution_places`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"service_id\": 1,\n  \"at_event_location\": true,\n  \"confirm\": true,\n  \"at_provider_location\": false\n}"
            }
          }
        },
        {
          "name": "Update service",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{provider_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/provider/services/{{provider_service_id}}",
            "description": "custom_price null resets to the guide price. Active providers only (409 INVALID_STATE otherwise). `at_event_location` is not accepted here (422): use Set event location (D73).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"custom_price\": 1800,\n  \"at_provider_location\": true,\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Set inclusions",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{provider_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/provider/services/{{provider_service_id}}/inclusions",
            "description": "Catalog inclusions to switch off. Active providers only (409 INVALID_STATE otherwise).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disabled_inclusion_ids\": []\n}"
            }
          }
        },
        {
          "name": "Set event location",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
