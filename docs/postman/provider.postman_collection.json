                "key": "Authorization",
                "value": "Bearer {{provider_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/provider/catalog",
            "description": "Catalog services she can offer with guide price, inclusions and add-ons. Active providers only (409 INVALID_STATE otherwise)."
          }
        },
        {
          "name": "My services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
