              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/settings/staff",
            "description": "D170: name, phone (Saudi mobile, normalised to E.164), optional email, one role. A phone used by any account (soft-deleted included) → 422. Non-super-admin: cannot assign super_admin or a role with permissions she lacks → 403 (D166).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara\",\n  \"phone\": \"0533334444\",\n  \"email\": null,\n  \"role\": \"operations_support\"\n}"
            }
          }
        },
        {
          "name": "Edit staff",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/settings/staff/{{staff_id}}",
            "description": "Name and email only (phone not editable, D170). Acting on a super admin needs super_admin (D166).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sara A.\",\n  \"email\": \"sara@example.com\"\n}"
            }
          }
        },
        {
          "name": "Role impact",
          "request": {
            "method": "POST",
            "header": [
