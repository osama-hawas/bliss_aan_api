            "url": "{{base_url}}/admin/settings/staff/{{staff_id}}",
            "description": "With status_history (last 20 suspend/reactivate entries, internal note included). Non-admin id → 404."
          }
        },
        {
          "name": "Create staff",
          "request": {
            "method": "POST",
            "header": [
              {
