              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/settings/staff/{{staff_id}}/role-impact",
            "description": "Preview only: {staff_count, staff, added, removed}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"store_content_officer\"\n}"
            }
          }
        },
