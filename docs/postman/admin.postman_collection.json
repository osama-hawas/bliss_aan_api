              }
            ],
            "url": "{{base_url}}/admin/service-requests?q=&filter[status]=&filter[type]=&filter[execution_place]=&filter[city_id]=&filter[service_id]=&filter[provider_id]=&filter[client_id]=&filter[event_from]=&filter[event_to]=&sort=-created_at&per_page=15",
            "description": "Read-only. q: reference, client name or phone, provider name. Event dates are Riyadh dates. Rows add client{id,name,phone} and recipients_count."
          }
        },
        {
          "name": "Show request",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/admin/service-requests/1",
            "description": "Complete request incl. address details, pin and client phone (D64), recipients with declines, full history (internal too). attachments[].url is null without requests.attachments.view."
          }
        },
        {
          "name": "Attachment URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/admin/service-requests/1/attachments/1",
            "description": "Needs requests.attachments.view too (super_admin only), else 403."
          }
        }
      ]
    },
    {
      "name": "Cancellation requests (bookings.view / cancellations.decide)",
      "description": "Slice 6, D131. Request detail (Service requests) also carries booking.cancellation_requests and booking.review.",
      "item": [
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/admin/cancellation-requests?filter[status]=under_review",
            "description": "filter[status], filter[requester_role], sort=created_at|-created_at, page, per_page."
          }
        },
        {
          "name": "Show",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/admin/cancellation-requests/{{cancellation_id}}",
            "description": "With the booking summary and internal_note."
          }
        },
        {
          "name": "Decide",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/cancellation-requests/{{cancellation_id}}/decide",
            "description": "Needs cancellations.decide. accept → booking + request cancelled (D128); reject → unchanged. Not under_review → 409 INVALID_STATE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"accept\",\n  \"decision_reason\": \"Checked with both parties.\",\n  \"internal_note\": \"Called the provider.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Staff accounts (roles.manage) — S14b",
      "description": "Slice 14b, D165–D170. Every route needs roles.manage.",
      "item": [
        {
