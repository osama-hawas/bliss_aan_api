            "url": "{{base_url}}/admin/settings/staff?q=&filter[role]=&filter[status]=active&sort=-created_at",
            "description": "q (name/phone), filter[role], filter[status] (active|suspended), sort name|created_at|last_login_at (− = desc), page, per_page ≤ 50."
          }
