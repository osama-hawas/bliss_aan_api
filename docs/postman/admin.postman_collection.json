              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/settings/staff/{{staff_id}}/role",
            "description": "One role per staff member (D167). Own account → 409 OWN_ACCOUNT; last active super admin → 409 LAST_SUPER_ADMIN (D165); same role → 409 INVALID_STATE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"store_content_officer\",\n  \"reason\": \"Moved to the store team\"\n}"
            }
          }
        },
        {
          "name": "Suspend staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
