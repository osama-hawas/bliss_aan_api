            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Contract ended\",\n  \"internal_note\": \"HR ticket 12\"\n}"
            }
          }
        },
        {
          "name": "Reactivate staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/settings/staff/{{staff_id}}/reactivate",
